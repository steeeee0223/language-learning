{
  "name": "language-learning",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": "24.11.1",
    "pnpm": "11.0.8"
  },
  "scripts": {
    "build": "next build --webpack",
    "dev": "next dev",
    "electron:compile": "tsx scripts/build-electron.ts",
    "electron:dev": "tsx scripts/build-electron.ts && electron . --dev",
    "electron:build": "tsx scripts/build-electron.ts && next build --webpack && tsx scripts/prepare-electron-server.ts",
    "electron:dist": "tsx scripts/build-electron.ts && next build --webpack && tsx scripts/prepare-electron-server.ts && electron-builder --mac dir",
    "start": "next start",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "eslint"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@openai/codex": "0.142.3",
    "@openai/codex-sdk": "0.142.3",
    "@tanstack/react-query": "^5.101.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "16.10.5",
    "fumadocs-mdx": "15.0.12",
    "fumadocs-ui": "16.10.5",
    "lucide-react": "^1.20.0",
    "next": "16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shadcn": "^4.11.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/mdx": "^2.0.14",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.9",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
